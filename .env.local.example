# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key: server-only, NEVER exposed to the browser, NEVER prefixed
# with NEXT_PUBLIC_. Used only for operations that must bypass RLS
# (e.g. looking up a user by email when inviting staff).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
