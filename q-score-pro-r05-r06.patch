+/**
+ * 固定ウィンドウ方式のメモリ内レート制限 (R-05)。
+ *
+ * 位置づけ: ベストエフォート。プロセスごとのメモリに保持するため、サーバーレス
+ * 環境で複数インスタンスに分かれると、インスタンスごとに数えることになる。
+ * DB を直接叩く経路は止められないので、本当の防御線は DB トリガー
+ * (0011 の guard_entry_insert) であり、これは「普通のスクリプトの連打」を
+ * 早めに弾いて DB と無料枠を守るための前段。
+ */
+export interface RateLimitResult {
+  allowed: boolean;
+  /** 次に許可されるまでの秒数 (allowed=false のときのみ > 0) */
+  retryAfterSeconds: number;
+}
+
+export interface RateLimiter {
+  check(key: string): RateLimitResult;
+}
+
+export function createRateLimiter(options: {
+  limit: number;
+  windowMs: number;
+  /** テスト用に時刻を差し替える */
+  now?: () => number;
+  /** 保持するキー数の上限。超えたら期限切れを掃除する */
+  maxKeys?: number;
+}): RateLimiter {
+  const { limit, windowMs } = options;
+  const now = options.now ?? Date.now;
+  const maxKeys = options.maxKeys ?? 10_000;
+  const buckets = new Map<string, { windowStart: number; count: number }>();
+
+  function sweep(t: number) {
+    for (const [key, b] of buckets) {
+      if (t - b.windowStart >= windowMs) buckets.delete(key);
+    }
+  }
+
+  return {
+    check(key) {
+      const t = now();
+      if (buckets.size >= maxKeys) sweep(t);
+
+      const b = buckets.get(key);
+      if (!b || t - b.windowStart >= windowMs) {
+        buckets.set(key, { windowStart: t, count: 1 });
+        return { allowed: true, retryAfterSeconds: 0 };
+      }
+      if (b.count >= limit) {
+        return {
+          allowed: false,
+          retryAfterSeconds: Math.max(1, Math.ceil((b.windowStart + windowMs - t) / 1000)),
+        };
+      }
+      b.count += 1;
+      return { allowed: true, retryAfterSeconds: 0 };
+    },
+  };
+}
+
+/**
+ * リクエスト元のIP。リバースプロキシ(Vercel等)の背後でのみ信頼できる値。
+ * 取れないときは "unknown" としてまとめて数える。
+ */
+export function clientIpFrom(headers: Headers): string {
+  const forwarded = headers.get("x-forwarded-for");
+  if (forwarded) {
+    const first = forwarded.split(",")[0]?.trim();
+    if (first) return first;
+  }
+  return headers.get("x-real-ip")?.trim() || "unknown";
+}
diff --git a/src/lib/tournament/member-rules.ts b/src/lib/tournament/member-rules.ts
new file mode 100644
index 0000000..0170eb0
--- /dev/null
+++ b/src/lib/tournament/member-rules.ts
@@ -0,0 +1,69 @@
+import type { TournamentMemberRole } from "@/types/database";
+
+/**
+ * スタッフ(tournament_members)の変更ルール (R-06)。
+ *
+ * 権限そのもの(manage_staff を持つか)は ROLE_ACTIONS / can() が判定する。
+ * ここは「manage_staff を持つ人が、誰に何をしてよいか」の業務ルール。
+ * DB 側は 0011 のトリガーが OWNER 関連だけを同じ内容で強制する(二重化)。
+ */
+export const ASSIGNABLE_ROLES = [
+  "ADMIN",
+  "QUESTION_MANAGER",
+  "SCORE_OPERATOR",
+  "GRADER",
+  "STREAM_OPERATOR",
+  "VENUE_STAFF",
+  "VIEWER",
+] as const satisfies readonly TournamentMemberRole[];
+
+export type AssignableRole = (typeof ASSIGNABLE_ROLES)[number];
+
+export type MemberChangeError =
+  | "target_is_owner"
+  | "cannot_change_self"
+  | "role_not_assignable";
+
+export interface MemberChangeInput {
+  actorUserId: string;
+  target: { userId: string; role: TournamentMemberRole };
+  /** ロール変更のときだけ指定する。削除のときは省略 */
+  newRole?: TournamentMemberRole;
+}
+
+export const MEMBER_CHANGE_MESSAGES: Record<MemberChangeError, string> = {
+  target_is_owner: "大会の作成者(OWNER)の権限は変更・削除できません",
+  cannot_change_self: "自分自身の権限の変更・削除はできません。他の管理者に依頼してください",
+  role_not_assignable: "そのロールは付与できません",
+};
+
+export function checkMemberChange(input: MemberChangeInput): MemberChangeError | null {
+  if (input.target.role === "OWNER") return "target_is_owner";
+  if (input.target.userId === input.actorUserId) return "cannot_change_self";
+  if (
+    input.newRole !== undefined &&
+    !(ASSIGNABLE_ROLES as readonly string[]).includes(input.newRole)
+  ) {
+    return "role_not_assignable";
+  }
+  return null;
+}
+
+export function mapMemberDbError(error: { message: string; code?: string | null }): {
+  status: number;
+  body: { error: string; message: string };
+} {
+  if (error.message.includes("owner_")) {
+    return {
+      status: 403,
+      body: { error: "target_is_owner", message: MEMBER_CHANGE_MESSAGES.target_is_owner },
+    };
+  }
+  if (error.code === "42501") {
+    return {
+      status: 403,
+      body: { error: "forbidden", message: "この操作を行う権限がありません" },
+    };
+  }
+  return { status: 500, body: { error: "internal_error", message: error.message } };
+}
diff --git a/supabase/migrations/0011_entry_guard_and_member_protection.sql b/supabase/migrations/0011_entry_guard_and_member_protection.sql
new file mode 100644
index 0000000..39bc1a9
--- /dev/null
+++ b/supabase/migrations/0011_entry_guard_and_member_protection.sql
@@ -0,0 +1,143 @@
+-- =============================================================================
+-- Q-Score Pro : 0011
+-- エントリーの重複防止・流量制限 / スタッフ(tournament_members)のOWNER保護
+--
+-- 対応する要件 (CONTRIBUTING.md 8.2章 / codereview.md):
+--   R-05 (Issue 4) 公開エントリーAPIのレート制限と重複防止
+--   R-06 (Issue 5) スタッフの削除・ロール変更(OWNERの削除・降格は不可)
+--
+-- 設計方針:
+-- - 公開エントリーは、匿名ユーザーが PostgREST を直接叩いても INSERT できる
+--   (RLS: entries_insert_public_when_open)。アプリ層だけの制限は回避されるため、
+--   重複防止と流量制限は DB のトリガーで行う。
+-- - 重複判定は (tournament_id, lower(email)) で、状態が SUBMITTED の行のみが対象。
+--   WITHDRAWN(取り下げ)済みの人は再エントリーできる。
+--   同時送信でもすり抜けないよう、メールごとに advisory lock を取って直列化する。
+-- - 流量制限は大会単位(1分間の受付上限)。IP単位の制限は DB からは信頼できる
+--   IP が取れないため、APIルート側のベストエフォートで行う。
+-- - tournament_members の OWNER は「大会作成者(tournaments.owner_id)だけ」が持てる。
+--   既存のRLS(admin は insert/update/delete 可)では、ADMIN が OWNER を新規付与したり
+--   OWNER を降格・削除できてしまうため、トリガーで塞ぐ。
+-- =============================================================================
+
+-- ---------------------------------------------------------------------------
+-- 1. R-05 : entries の重複防止と流量制限
+-- ---------------------------------------------------------------------------
+
+-- 重複判定用の部分インデックス (一意制約ではなく、トリガーが一意性を保証する。
+-- 既存データに重複がある環境でもマイグレーションが失敗しないようにするため)
+create index entries_tournament_lower_email_idx
+  on public.entries (tournament_id, lower(email))
+  where status = 'SUBMITTED';
+
+create function public.guard_entry_insert()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  -- 1大会あたり、1分間に受け付けるエントリー数の上限。
+  -- 人気大会の受付開始直後の集中(数十件/分)は許容し、機械的な大量投入を止める値。
+  c_max_per_minute constant int := 60;
+  v_recent int;
+begin
+  new.email := btrim(new.email);
+
+  -- 同じ大会・同じメールの同時INSERTを直列化する
+  perform pg_advisory_xact_lock(
+    hashtextextended('entries:' || new.tournament_id::text || ':' || lower(new.email), 0)
+  );
+
+  if new.status = 'SUBMITTED' and exists (
+    select 1
+    from public.entries e
+    where e.tournament_id = new.tournament_id
+      and lower(e.email) = lower(new.email)
+      and e.status = 'SUBMITTED'
+  ) then
+    raise exception 'entry_duplicate'
+      using errcode = '23505',
+            hint = 'このメールアドレスは、この大会に既にエントリー済みです';
+  end if;
+
+  select count(*) into v_recent
+  from public.entries e
+  where e.tournament_id = new.tournament_id
+    and e.submitted_at > now() - interval '1 minute';
+
+  if v_recent >= c_max_per_minute then
+    raise exception 'entry_rate_limited'
+      using errcode = 'QS429',
+            hint = '短時間にエントリーが集中しています。少し待ってから再度お試しください';
+  end if;
+
+  return new;
+end;
+$$;
+
+create trigger guard_entries_insert
+  before insert on public.entries
+  for each row execute procedure public.guard_entry_insert();
+
+-- ---------------------------------------------------------------------------
+-- 2. R-06 : tournament_members の OWNER 保護
+-- ---------------------------------------------------------------------------
+
+create function public.guard_tournament_member_change()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_owner_id uuid;
+begin
+  if tg_op = 'INSERT' then
+    -- OWNER を持てるのは大会作成者だけ (作成直後の bootstrap 登録)
+    if new.role = 'OWNER' then
+      select t.owner_id into v_owner_id from public.tournaments t where t.id = new.tournament_id;
+      if new.user_id is distinct from v_owner_id then
+        raise exception 'owner_role_reserved'
+          using errcode = '42501',
+                hint = 'OWNER は大会の作成者のみが持てます';
+      end if;
+    end if;
+    return new;
+
+  elsif tg_op = 'UPDATE' then
+    if new.tournament_id is distinct from old.tournament_id
+       or new.user_id is distinct from old.user_id then
+      raise exception 'member_identity_immutable'
+        using errcode = '22023',
+              hint = 'スタッフの大会・ユーザーは変更できません';
+    end if;
+    if old.role = 'OWNER' and new.role <> 'OWNER' then
+      raise exception 'owner_cannot_be_demoted'
+        using errcode = '42501',
+              hint = 'OWNER の権限は変更できません';
+    end if;
+    if new.role = 'OWNER' and old.role <> 'OWNER' then
+      raise exception 'owner_role_reserved'
+        using errcode = '42501',
+              hint = 'OWNER は大会の作成者のみが持てます';
+    end if;
+    return new;
+
+  else -- DELETE
+    -- 大会そのものが削除されている最中(カスケード)は OWNER 行も消えてよい。
+    -- 大会が存在する間は OWNER を削除できない。
+    if old.role = 'OWNER'
+       and exists (select 1 from public.tournaments t where t.id = old.tournament_id) then
+      raise exception 'owner_cannot_be_removed'
+        using errcode = '42501',
+              hint = 'OWNER は削除できません';
+    end if;
+    return old;
+  end if;
+end;
+$$;
+
+create trigger guard_tournament_members_change
+  before insert or update or delete on public.tournament_members
+  for each row execute procedure public.guard_tournament_member_change();
diff --git a/tests/db/0011_entry_guard_and_member_protection.sql b/tests/db/0011_entry_guard_and_member_protection.sql
new file mode 100644
index 0000000..f4cdfdc
--- /dev/null
+++ b/tests/db/0011_entry_guard_and_member_protection.sql
@@ -0,0 +1,158 @@
+-- =============================================================================
+-- DB回帰テスト: 0011 (R-05 エントリーの重複防止・流量制限 / R-06 OWNER保護)
+--
+-- 実行方法 (ローカルSupabaseを起動した状態で。全体をロールバックするので何も残らない):
+--   psql "postgresql://postgres:postgres@127.0.0.1:54322/postgres" \
+--     -v ON_ERROR_STOP=1 -f tests/db/0011_entry_guard_and_member_protection.sql
+-- 成功すると最後に "ALL PASSED" が出る。失敗すると "FAIL: ..." で止まる。
+-- =============================================================================
+begin;
+
+insert into auth.users (id, email) values
+  ('00000000-0000-0000-0000-00000000000a', 'owner@t.example'),
+  ('00000000-0000-0000-0000-00000000000b', 'admin@t.example'),
+  ('00000000-0000-0000-0000-00000000000c', 'op@t.example');
+
+insert into public.tournaments (id, slug, name, status, owner_id) values
+  ('10000000-0000-0000-0000-000000000001', 't-guard-open', 'T', 'REGISTRATION_OPEN', '00000000-0000-0000-0000-00000000000a'),
+  ('10000000-0000-0000-0000-000000000002', 't-guard-del',  'D', 'DRAFT',             '00000000-0000-0000-0000-00000000000a');
+
+insert into public.tournament_members (tournament_id, user_id, role) values
+  ('10000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000a', 'OWNER'),
+  ('10000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000b', 'ADMIN'),
+  ('10000000-0000-0000-0000-000000000001', '00000000-0000-0000-0000-00000000000c', 'SCORE_OPERATOR'),
+  ('10000000-0000-0000-0000-000000000002', '00000000-0000-0000-0000-00000000000a', 'OWNER');
+
+-- ---------------------------------------------------------------------------
+-- R-05: 匿名ユーザーによるエントリー
+-- ---------------------------------------------------------------------------
+do $$
+declare v_hit boolean;
+begin
+  set local role anon;
+
+  insert into public.entries (tournament_id, display_name, email)
+  values ('10000000-0000-0000-0000-000000000001', 'A', 'Foo@Example.com');
+
+  -- 大文字小文字・前後の空白が違っても同じメールとして重複扱い
+  v_hit := false;
+  begin
+    insert into public.entries (tournament_id, display_name, email)
+    values ('10000000-0000-0000-0000-000000000001', 'B', '  foo@example.COM ');
+  exception when others then
+    v_hit := (sqlstate = '23505' and sqlerrm = 'entry_duplicate');
+  end;
+  if not v_hit then raise exception 'FAIL: 同じメールの重複エントリーが拒否されない'; end if;
+
+  -- 別のメールは通る
+  insert into public.entries (tournament_id, display_name, email)
+  values ('10000000-0000-0000-0000-000000000001', 'C', 'bar@example.com');
+
+  reset role;
+  -- 取り下げ済みなら同じメールで再エントリーできる
+  update public.entries set status = 'WITHDRAWN' where lower(email) = 'foo@example.com';
+  set local role anon;
+  insert into public.entries (tournament_id, display_name, email)
+  values ('10000000-0000-0000-0000-000000000001', 'A2', 'foo@example.com');
+  reset role;
+end $$;
+
+do $$
+declare
+  v_hit boolean := false;
+  v_ok int := 0;
+  i int;
+begin
+  set local role anon;
+  -- ここまでに3件。1分間の上限(60件)に達したら QS429 で止まる
+  for i in 1..70 loop
+    begin
+      insert into public.entries (tournament_id, display_name, email)
+      values ('10000000-0000-0000-0000-000000000001', 'u' || i, 'u' || i || '@e.example');
+      v_ok := v_ok + 1;
+    exception when others then
+      v_hit := (sqlstate = 'QS429' and sqlerrm = 'entry_rate_limited');
+      exit;
+    end;
+  end loop;
+  reset role;
+  if not v_hit then raise exception 'FAIL: 流量制限(QS429)に達しない'; end if;
+  if v_ok <> 57 then raise exception 'FAIL: 上限までの受付件数が想定と違う (got %, want 57)', v_ok; end if;
+end $$;
+
+-- ---------------------------------------------------------------------------
+-- R-06: ADMIN によるスタッフ操作
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  v_hit boolean;
+  c_t constant uuid := '10000000-0000-0000-0000-000000000001';
+  c_op constant uuid := '00000000-0000-0000-0000-00000000000c';
+begin
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-00000000000b', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-00000000000b', 'role', 'authenticated')::text, true);
+  set local role authenticated;
+
+  -- OWNER の降格は不可
+  v_hit := false;
+  begin
+    update public.tournament_members set role = 'VIEWER' where tournament_id = c_t and role = 'OWNER';
+  exception when others then v_hit := (sqlerrm = 'owner_cannot_be_demoted'); end;
+  if not v_hit then raise exception 'FAIL: ADMIN が OWNER を降格できてしまう'; end if;
+
+  -- OWNER の削除は不可
+  v_hit := false;
+  begin
+    delete from public.tournament_members where tournament_id = c_t and role = 'OWNER';
+  exception when others then v_hit := (sqlerrm = 'owner_cannot_be_removed'); end;
+  if not v_hit then raise exception 'FAIL: ADMIN が OWNER を削除できてしまう'; end if;
+
+  -- 他人を OWNER に昇格できない
+  v_hit := false;
+  begin
+    update public.tournament_members set role = 'OWNER' where user_id = c_op;
+  exception when others then v_hit := (sqlerrm = 'owner_role_reserved'); end;
+  if not v_hit then raise exception 'FAIL: ADMIN が OWNER を新規に付与できる(UPDATE)'; end if;
+
+  -- OWNER 行を直接 INSERT することもできない
+  delete from public.tournament_members where user_id = c_op;
+  v_hit := false;
+  begin
+    insert into public.tournament_members (tournament_id, user_id, role) values (c_t, c_op, 'OWNER');
+  exception when others then v_hit := (sqlerrm = 'owner_role_reserved'); end;
+  if not v_hit then raise exception 'FAIL: ADMIN が OWNER を新規に付与できる(INSERT)'; end if;
+
+  -- 一般スタッフの追加・ロール変更・削除は通る
+  insert into public.tournament_members (tournament_id, user_id, role) values (c_t, c_op, 'SCORE_OPERATOR');
+  update public.tournament_members set role = 'GRADER' where user_id = c_op;
+  if (select role from public.tournament_members where user_id = c_op and tournament_id = c_t) <> 'GRADER' then
+    raise exception 'FAIL: ロール変更が反映されない';
+  end if;
+
+  -- 行の付け替え(user_id の変更)は不可
+  v_hit := false;
+  begin
+    update public.tournament_members
+       set user_id = '00000000-0000-0000-0000-00000000000b' where user_id = c_op;
+  exception when others then v_hit := (sqlerrm = 'member_identity_immutable'); end;
+  if not v_hit then raise exception 'FAIL: user_id を付け替えられる'; end if;
+
+  delete from public.tournament_members where user_id = c_op and tournament_id = c_t;
+  reset role;
+  if exists (select 1 from public.tournament_members where user_id = c_op and tournament_id = c_t) then
+    raise exception 'FAIL: 一般スタッフを削除できない';
+  end if;
+end $$;
+
+-- 大会を削除すると OWNER 行もカスケードで消える(保護トリガーが邪魔しない)
+do $$
+begin
+  delete from public.tournaments where id = '10000000-0000-0000-0000-000000000002';
+  if exists (select 1 from public.tournament_members where tournament_id = '10000000-0000-0000-0000-000000000002') then
+    raise exception 'FAIL: 大会削除のカスケードで OWNER 行が残る';
+  end if;
+end $$;
+
+select 'ALL PASSED' as result;
+rollback;
diff --git a/tests/unit/entry-guard.test.ts b/tests/unit/entry-guard.test.ts
new file mode 100644
index 0000000..925fc03
--- /dev/null
+++ b/tests/unit/entry-guard.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from "vitest";
+import { mapEntryInsertError } from "@/lib/entries/guard";
+
+describe("mapEntryInsertError (R-05)", () => {
+  it("重複(23505)は 409 entry_duplicate", () => {
+    const r = mapEntryInsertError({ code: "23505", message: "entry_duplicate" });
+    expect(r.status).toBe(409);
+    expect(r.body.error).toBe("entry_duplicate");
+    expect(r.body.message).toContain("既にエントリー済み");
+  });
+
+  it("コードが落ちてもメッセージで重複を判定できる", () => {
+    expect(mapEntryInsertError({ message: "entry_duplicate" }).status).toBe(409);
+  });
+
+  it("受付上限(QS429)は 429 で Retry-After を返す", () => {
+    const r = mapEntryInsertError({ code: "QS429", message: "entry_rate_limited" });
+    expect(r.status).toBe(429);
+    expect(r.headers?.["Retry-After"]).toBe("60");
+    expect(r.body.error).toBe("entry_rate_limited");
+  });
+
+  it("RLS違反(受付中ではない)は 409 entries_closed", () => {
+    const r = mapEntryInsertError({
+      code: "42501",
+      message: 'new row violates row-level security policy for table "entries"',
+    });
+    expect(r.status).toBe(409);
+    expect(r.body.error).toBe("entries_closed");
+  });
+
+  it("想定外のエラーは 500 でメッセージをそのまま返す", () => {
+    const r = mapEntryInsertError({ code: "XX000", message: "boom" });
+    expect(r).toEqual({ status: 500, body: { error: "boom" } });
+  });
+});
diff --git a/tests/unit/member-rules.test.ts b/tests/unit/member-rules.test.ts
new file mode 100644
index 0000000..91f9b3d
--- /dev/null
+++ b/tests/unit/member-rules.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+import {
+  ASSIGNABLE_ROLES,
+  checkMemberChange,
+  mapMemberDbError,
+} from "@/lib/tournament/member-rules";
+
+const ME = "user-me";
+
+describe("checkMemberChange (R-06)", () => {
+  it("OWNER は変更も削除もできない", () => {
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: "u1", role: "OWNER" }, newRole: "VIEWER" })
+    ).toBe("target_is_owner");
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: "u1", role: "OWNER" } })
+    ).toBe("target_is_owner");
+  });
+
+  it("自分自身は変更も削除もできない", () => {
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: ME, role: "ADMIN" }, newRole: "VIEWER" })
+    ).toBe("cannot_change_self");
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: ME, role: "ADMIN" } })
+    ).toBe("cannot_change_self");
+  });
+
+  it("OWNER ロールは付与できない", () => {
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: "u1", role: "VIEWER" }, newRole: "OWNER" })
+    ).toBe("role_not_assignable");
+  });
+
+  it("一般スタッフのロール変更・削除は許可される", () => {
+    expect(
+      checkMemberChange({
+        actorUserId: ME,
+        target: { userId: "u1", role: "VIEWER" },
+        newRole: "SCORE_OPERATOR",
+      })
+    ).toBeNull();
+    expect(
+      checkMemberChange({ actorUserId: ME, target: { userId: "u1", role: "GRADER" } })
+    ).toBeNull();
