+alter type public.tournament_status add value if not exists 'CANCELLED';
diff --git a/supabase/migrations/0013_tournament_status_workflow.sql b/supabase/migrations/0013_tournament_status_workflow.sql
new file mode 100644
index 0000000..7fa2cb4
--- /dev/null
+++ b/supabase/migrations/0013_tournament_status_workflow.sql
@@ -0,0 +1,201 @@
+-- =============================================================================
+-- Q-Score Pro : 0013
+-- 大会ステータスの遷移をDBで強制し、訂正・中止を監査ログ必須にする
+--
+-- 対応する要件 (CONTRIBUTING.md 8.3章 / codereview.md):
+--   R-08 (Issue 9) 公開後の訂正(PUBLISHED→RUNNING、監査ログ必須)と CANCELLED
+--
+-- 設計方針:
+-- - 遷移表は src/lib/tournament/status.ts の ALLOWED_TRANSITIONS と同じ内容を
+--   このファイルの tournament_status_transition_allowed() に持つ。対応関係は
+--   tests/unit/tournament-status.test.ts がこのファイルを解析して検証する。
+--   片方を変えたら、もう片方も必ず同時に直すこと。
+-- - 遷移の検証と監査ログの記録は tournaments の BEFORE UPDATE トリガーで行う。
+--   アプリのAPIだけでなく、PostgREST を直接叩いても同じ検証が効き、
+--   「ステータスは変わったのに監査ログが無い」状態が起きない(同一トランザクション)。
+-- - 訂正(PUBLISHED→RUNNING)と中止(→CANCELLED)は理由が必須。理由は RPC
+--   change_tournament_status() がトランザクション内の設定値 qscore.status_reason
+--   として渡し、トリガーが読んで監査ログに残す。
+-- - CANCELLED にできるのは、既に公開されていた状態(受付中〜開催中)からのみ。
+--   下書きは公開されたことがないので、中止ではなく削除する。
+-- - CANCELLED は終端状態(元に戻せない)。
+-- =============================================================================
+
+-- ---------------------------------------------------------------------------
+-- 1. 公開範囲: 列挙(IN (...))をやめ「DRAFT 以外」にする
+--    列挙のままだと CANCELLED の大会が公開ページから消え、申込者が404を見ることになる。
+--    中止された大会は「中止されました」と表示できるよう、公開のままにする。
+-- ---------------------------------------------------------------------------
+drop policy "tournaments_select_public" on public.tournaments;
+create policy "tournaments_select_public"
+  on public.tournaments for select
+  using (status <> 'DRAFT');
+
+drop policy "announcements_select_public" on public.announcements;
+create policy "announcements_select_public"
+  on public.announcements for select
+  using (
+    is_published = true
+    and exists (
+      select 1 from public.tournaments t
+      where t.id = tournament_id and t.status <> 'DRAFT'
+    )
+  );
+
+drop policy "schedule_items_select_public" on public.schedule_items;
+create policy "schedule_items_select_public"
+  on public.schedule_items for select
+  using (
+    exists (
+      select 1 from public.tournaments t
+      where t.id = tournament_id and t.status <> 'DRAFT'
+    )
+  );
+
+drop policy "entry_form_fields_select_public" on public.entry_form_fields;
+create policy "entry_form_fields_select_public"
+  on public.entry_form_fields for select
+  using (
+    exists (
+      select 1 from public.tournaments t
+      where t.id = tournament_id and t.status <> 'DRAFT'
+    )
+  );
+
+-- ---------------------------------------------------------------------------
+-- 2. 遷移表と「理由が必要な遷移」
+-- ---------------------------------------------------------------------------
+create function public.tournament_status_transition_allowed(p_from text, p_to text)
+returns boolean
+language sql
+immutable
+as $$
+  select (p_from, p_to) in (
+    ('DRAFT',               'REGISTRATION_OPEN'),
+    ('REGISTRATION_OPEN',   'REGISTRATION_CLOSED'),
+    ('REGISTRATION_OPEN',   'DRAFT'),
+    ('REGISTRATION_OPEN',   'CANCELLED'),
+    ('REGISTRATION_CLOSED', 'RUNNING'),
+    ('REGISTRATION_CLOSED', 'REGISTRATION_OPEN'),
+    ('REGISTRATION_CLOSED', 'CANCELLED'),
+    ('RUNNING',             'FINISHED'),
+    ('RUNNING',             'CANCELLED'),
+    ('FINISHED',            'PUBLISHED'),
+    ('PUBLISHED',           'RUNNING')   -- 公開後の訂正(理由必須)
+  );
+$$;
+
+-- 訂正(公開結果の取り下げ)と中止は、理由の記録を必須にする
+create function public.tournament_status_requires_reason(p_from text, p_to text)
+returns boolean
+language sql
+immutable
+as $$
+  select p_from = 'PUBLISHED' or p_to = 'CANCELLED';
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 3. トリガー: 遷移の検証 + 監査ログの記録 (同一トランザクション)
+-- ---------------------------------------------------------------------------
+create function public.guard_tournament_status_change()
+returns trigger
+language plpgsql
+security definer
+set search_path = public
+as $$
+declare
+  v_from text := old.status::text;
+  v_to text := new.status::text;
+  v_reason text;
+  v_action text;
+  v_summary text;
+begin
+  if v_from = v_to then
+    return new;
+  end if;
+
+  if not public.tournament_status_transition_allowed(v_from, v_to) then
+    raise exception 'invalid_status_transition'
+      using errcode = '22023',
+            detail = v_from || ' -> ' || v_to;
+  end if;
+
+  v_reason := left(nullif(btrim(coalesce(current_setting('qscore.status_reason', true), '')), ''), 500);
+
+  if public.tournament_status_requires_reason(v_from, v_to) and v_reason is null then
+    raise exception 'status_reason_required'
+      using errcode = '22023',
+            hint = '訂正・中止には理由が必要です';
+  end if;
+
+  if v_to = 'CANCELLED' then
+    v_action := 'tournament.cancelled';
+    v_summary := '大会を中止しました(理由: ' || v_reason || ')';
+  elsif v_from = 'PUBLISHED' then
+    v_action := 'tournament.status_corrected';
+    v_summary := '公開済みの大会を ' || v_to || ' に訂正しました(理由: ' || v_reason || ')';
+  else
+    v_action := 'tournament.status_changed';
+    v_summary := '大会のステータスを ' || v_from || ' から ' || v_to || ' に変更しました';
+  end if;
+
+  insert into public.audit_logs (tournament_id, actor_id, action, summary, metadata)
+  values (
+    old.id,
+    auth.uid(),
+    v_action,
+    v_summary,
+    jsonb_build_object('from', v_from, 'to', v_to, 'reason', v_reason)
+  );
+
+  return new;
+end;
+$$;
+
+create trigger guard_tournaments_status_change
+  before update of status on public.tournaments
+  for each row execute procedure public.guard_tournament_status_change();
+
+-- ---------------------------------------------------------------------------
+-- 4. RPC: ステータス変更 (理由つき)
+--    security invoker: tournaments の更新RLS(OWNER/ADMIN)がそのまま効く。
+--    理由をトリガーへ渡すための入口で、検証はトリガーが行う。
+-- ---------------------------------------------------------------------------
+create function public.change_tournament_status(
+  p_tournament_id uuid,
+  p_status text,
+  p_reason text default null
+)
+returns public.tournaments
+language plpgsql
+security invoker
+set search_path = public
+as $$
+declare
+  v_row public.tournaments;
+  v_count int;
+begin
+  perform set_config('qscore.status_reason', coalesce(p_reason, ''), true);
+
+  update public.tournaments
+     set status = p_status::public.tournament_status
+   where id = p_tournament_id
+  returning * into v_row;
+
+  -- 注意: PERFORM は FOUND を上書きするため、行数は更新の直後に確保する。
+  -- RLS で見えない/更新できない場合は 0 行になる(権限がない場合も not found と同じ扱い)
+  get diagnostics v_count = row_count;
+
+  -- 理由は同じトランザクション内の別の更新に持ち越さない
+  perform set_config('qscore.status_reason', '', true);
+
+  if v_count = 0 then
+    raise exception 'tournament_not_found' using errcode = 'P0002';
+  end if;
+
+  return v_row;
+end;
+$$;
+
+revoke all on function public.change_tournament_status(uuid, text, text) from public, anon;
+grant execute on function public.change_tournament_status(uuid, text, text) to authenticated;
diff --git a/tests/db/0013_tournament_status_workflow.sql b/tests/db/0013_tournament_status_workflow.sql
new file mode 100644
index 0000000..67f6cd3
--- /dev/null
+++ b/tests/db/0013_tournament_status_workflow.sql
@@ -0,0 +1,219 @@
+-- =============================================================================
+-- DB回帰テスト: 0012/0013 (R-08 大会ステータスの訂正・中止と遷移の強制)
+--
+-- 実行方法 (ローカルSupabaseを起動した状態で。全体をロールバックするので何も残らない):
+--   psql "postgresql://postgres:postgres@127.0.0.1:54322/postgres" \
+--     -v ON_ERROR_STOP=1 -f tests/db/0013_tournament_status_workflow.sql
+-- 成功すると最後に "ALL PASSED" が出る。失敗すると "FAIL: ..." で止まる。
+-- =============================================================================
+begin;
+
+insert into auth.users (id, email) values
+  ('00000000-0000-0000-0000-0000000000a1', 'owner@s.example'),
+  ('00000000-0000-0000-0000-0000000000b1', 'admin@s.example'),
+  ('00000000-0000-0000-0000-0000000000c1', 'op@s.example');
+
+insert into public.tournaments (id, slug, name, status, owner_id) values
+  ('20000000-0000-0000-0000-000000000001', 't-status-main',   'Main',   'DRAFT', '00000000-0000-0000-0000-0000000000a1'),
+  ('20000000-0000-0000-0000-000000000002', 't-status-cancel', 'Cancel', 'DRAFT', '00000000-0000-0000-0000-0000000000a1');
+
+insert into public.tournament_members (tournament_id, user_id, role)
+select t.id, u.user_id, u.role::public.tournament_member_role
+from public.tournaments t
+cross join (values
+  ('00000000-0000-0000-0000-0000000000a1'::uuid, 'OWNER'),
+  ('00000000-0000-0000-0000-0000000000b1'::uuid, 'ADMIN'),
+  ('00000000-0000-0000-0000-0000000000c1'::uuid, 'SCORE_OPERATOR')
+) as u(user_id, role)
+where t.slug in ('t-status-main', 't-status-cancel');
+
+-- ---------------------------------------------------------------------------
+-- 通常の遷移・不正な遷移 (ADMIN)
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  v_hit boolean;
+  c_t constant uuid := '20000000-0000-0000-0000-000000000001';
+begin
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000b1', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-0000000000b1', 'role', 'authenticated')::text, true);
+  set local role authenticated;
+
+  perform public.change_tournament_status(c_t, 'REGISTRATION_OPEN');
+  if (select status from public.tournaments where id = c_t) <> 'REGISTRATION_OPEN' then
+    raise exception 'FAIL: 通常の遷移(DRAFT→REGISTRATION_OPEN)が反映されない';
+  end if;
+
+  -- 段飛ばしはRPCでも、テーブルを直接更新(PostgREST直叩き相当)でも拒否される
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'RUNNING');
+  exception when others then v_hit := (sqlerrm = 'invalid_status_transition'); end;
+  if not v_hit then raise exception 'FAIL: 段飛ばし遷移がRPCで拒否されない'; end if;
+
+  v_hit := false;
+  begin
+    update public.tournaments set status = 'FINISHED' where id = c_t;
+  exception when others then v_hit := (sqlerrm = 'invalid_status_transition'); end;
+  if not v_hit then raise exception 'FAIL: 段飛ばし遷移が直接UPDATEで拒否されない'; end if;
+
+  -- 直接UPDATEでは理由を渡せないので、中止は拒否される
+  v_hit := false;
+  begin
+    update public.tournaments set status = 'CANCELLED' where id = c_t;
+  exception when others then v_hit := (sqlerrm = 'status_reason_required'); end;
+  if not v_hit then raise exception 'FAIL: 理由なしの中止(直接UPDATE)が拒否されない'; end if;
+
+  perform public.change_tournament_status(c_t, 'REGISTRATION_CLOSED');
+  perform public.change_tournament_status(c_t, 'RUNNING');
+  perform public.change_tournament_status(c_t, 'FINISHED');
+  perform public.change_tournament_status(c_t, 'PUBLISHED');
+  reset role;
+
+  if (select count(*) from public.audit_logs where tournament_id = c_t and action = 'tournament.status_changed') <> 5 then
+    raise exception 'FAIL: 通常の遷移5回ぶんの監査ログが残っていない';
+  end if;
+  if exists (
+    select 1 from public.audit_logs
+    where tournament_id = c_t and actor_id is distinct from '00000000-0000-0000-0000-0000000000b1'
+  ) then
+    raise exception 'FAIL: 監査ログの実行者(actor_id)が記録されていない';
+  end if;
+end $$;
+
+-- ---------------------------------------------------------------------------
+-- 公開後の訂正 (PUBLISHED → RUNNING): 理由必須 + 監査ログ必須
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  v_hit boolean;
+  c_t constant uuid := '20000000-0000-0000-0000-000000000001';
+  v_meta jsonb;
+begin
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000b1', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-0000000000b1', 'role', 'authenticated')::text, true);
+  set local role authenticated;
+
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'RUNNING');
+  exception when others then v_hit := (sqlerrm = 'status_reason_required'); end;
+  if not v_hit then raise exception 'FAIL: 理由なしの訂正が拒否されない'; end if;
+
+  -- 空白だけの理由も「理由なし」
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'RUNNING', '   ');
+  exception when others then v_hit := (sqlerrm = 'status_reason_required'); end;
+  if not v_hit then raise exception 'FAIL: 空白だけの理由が受理される'; end if;
+
+  if (select status from public.tournaments where id = c_t) <> 'PUBLISHED' then
+    raise exception 'FAIL: 拒否された訂正で状態が変わってしまった';
+  end if;
+
+  perform public.change_tournament_status(c_t, 'RUNNING', '得点の入力ミスを訂正するため');
+  reset role;
+
+  select metadata into v_meta
+  from public.audit_logs
+  where tournament_id = c_t and action = 'tournament.status_corrected';
+  if v_meta is null then raise exception 'FAIL: 訂正の監査ログが残っていない'; end if;
+  if v_meta ->> 'reason' <> '得点の入力ミスを訂正するため'
+     or v_meta ->> 'from' <> 'PUBLISHED' or v_meta ->> 'to' <> 'RUNNING' then
+    raise exception 'FAIL: 訂正の監査ログの内容が正しくない: %', v_meta;
+  end if;
+
+  -- 理由が次の更新に持ち越されない(同一トランザクション内でも)
+  set local role authenticated;
+  perform public.change_tournament_status(c_t, 'FINISHED');
+  perform public.change_tournament_status(c_t, 'PUBLISHED');
+  v_hit := false;
+  begin
+    update public.tournaments set status = 'RUNNING' where id = c_t;
+  exception when others then v_hit := (sqlerrm = 'status_reason_required'); end;
+  reset role;
+  if not v_hit then raise exception 'FAIL: 前回の理由が持ち越されて、理由なし訂正が通ってしまう'; end if;
+end $$;
+
+-- ---------------------------------------------------------------------------
+-- 中止 (CANCELLED)
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  v_hit boolean;
+  c_t constant uuid := '20000000-0000-0000-0000-000000000002';
+begin
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000b1', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-0000000000b1', 'role', 'authenticated')::text, true);
+  set local role authenticated;
+
+  -- 下書きは中止できない(公開されたことがないので、削除する)
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'CANCELLED', '理由');
+  exception when others then v_hit := (sqlerrm = 'invalid_status_transition'); end;
+  if not v_hit then raise exception 'FAIL: DRAFT→CANCELLED が拒否されない'; end if;
+
+  perform public.change_tournament_status(c_t, 'REGISTRATION_OPEN');
+
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'CANCELLED');
+  exception when others then v_hit := (sqlerrm = 'status_reason_required'); end;
+  if not v_hit then raise exception 'FAIL: 理由なしの中止が拒否されない'; end if;
+
+  -- スタッフでも ADMIN 未満(SCORE_OPERATOR)は変更できない
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000c1', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-0000000000c1', 'role', 'authenticated')::text, true);
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'CANCELLED', '権限のない中止');
+  exception when others then v_hit := (sqlstate = 'P0002'); end;
+  if not v_hit then raise exception 'FAIL: SCORE_OPERATOR がステータスを変更できてしまう'; end if;
+
+  perform set_config('request.jwt.claim.sub', '00000000-0000-0000-0000-0000000000b1', true);
+  perform set_config('request.jwt.claims',
+    json_build_object('sub', '00000000-0000-0000-0000-0000000000b1', 'role', 'authenticated')::text, true);
+  perform public.change_tournament_status(c_t, 'CANCELLED', '会場が使用できなくなったため');
+
+  -- CANCELLED は終端状態
+  v_hit := false;
+  begin
+    perform public.change_tournament_status(c_t, 'DRAFT');
+  exception when others then v_hit := (sqlerrm = 'invalid_status_transition'); end;
+  if not v_hit then raise exception 'FAIL: CANCELLED から戻せてしまう'; end if;
+  reset role;
+
+  if not exists (
+    select 1 from public.audit_logs
+    where tournament_id = c_t and action = 'tournament.cancelled'
+      and metadata ->> 'reason' = '会場が使用できなくなったため'
+  ) then
+    raise exception 'FAIL: 中止の監査ログが残っていない';
+  end if;
+end $$;
+
+-- ---------------------------------------------------------------------------
+-- 公開範囲: 中止された大会は公開のまま(申込者が404を見ない)、下書きは非公開
+-- ---------------------------------------------------------------------------
+do $$
+declare
+  v_n int;
+begin
+  insert into public.tournaments (id, slug, name, status, owner_id) values
+    ('20000000-0000-0000-0000-000000000003', 't-status-draft', 'Draft', 'DRAFT', '00000000-0000-0000-0000-0000000000a1');
+
+  set local role anon;
+  select count(*) into v_n from public.tournaments where slug = 't-status-cancel';
+  if v_n <> 1 then raise exception 'FAIL: 中止された大会が公開ページから見えない'; end if;
+  select count(*) into v_n from public.tournaments where slug = 't-status-draft';
+  if v_n <> 0 then raise exception 'FAIL: 下書きの大会が匿名に見えてしまう'; end if;
+  reset role;
+end $$;
+
+select 'ALL PASSED' as result;
+rollback;
