@@ -0,0 +1,120 @@
+/**
+ * 大会ページ用の最小限の Markdown パーサー(依存なし・HTMLは一切通さない)。
+ *
+ * 対応: 見出し(# ## ###)、段落(行末の改行は <br>)、箇条書き(- / * / 1.)、区切り線(---)、
+ *       **太字**、`コード`、[リンク](https://...)。
+ * 安全性: パース結果は AST で、描画側が React 要素として出力する(dangerouslySetInnerHTML を使わない)。
+ *       書かれた HTML タグはただの文字として表示される。リンクは http / https / mailto のみ許可し、
+ *       javascript: や data: は文字のまま(リンクにしない)。
+ */
+export type Inline =
+  | { type: "text"; value: string }
+  | { type: "bold"; value: string }
+  | { type: "code"; value: string }
+  | { type: "link"; href: string; value: string };
+
+export type Block =
+  | { type: "heading"; level: 1 | 2 | 3; content: Inline[] }
+  | { type: "paragraph"; lines: Inline[][] }
+  | { type: "list"; ordered: boolean; items: Inline[][] }
+  | { type: "rule" };
+
+const SAFE_HREF = /^(https?:\/\/|mailto:)[^\s]+$/i;
+
+export function isSafeHref(href: string): boolean {
+  return SAFE_HREF.test(href);
+}
+
+const INLINE = /(\*\*[^*\n]+\*\*|`[^`\n]+`|\[[^\]\n]+\]\([^)\s]+\))/g;
+
+export function parseInline(text: string): Inline[] {
+  const out: Inline[] = [];
+  let last = 0;
+  for (const m of text.matchAll(INLINE)) {
+    const index = m.index ?? 0;
+    if (index > last) out.push({ type: "text", value: text.slice(last, index) });
+    const token = m[0];
+    if (token.startsWith("**")) {
+      out.push({ type: "bold", value: token.slice(2, -2) });
+    } else if (token.startsWith("`")) {
+      out.push({ type: "code", value: token.slice(1, -1) });
+    } else {
+      const close = token.indexOf("](");
+      const label = token.slice(1, close);
+      const href = token.slice(close + 2, -1);
+      // 危険なURLはリンクにせず、書かれたとおりの文字として残す
+      out.push(isSafeHref(href) ? { type: "link", href, value: label } : { type: "text", value: token });
+    }
+    last = index + token.length;
+  }
+  if (last < text.length) out.push({ type: "text", value: text.slice(last) });
+  return mergeText(out);
+}
+
+/** 隣り合うテキストを1つにまとめる(危険なリンクを文字に戻したときなどに分かれるため)。 */
+function mergeText(nodes: Inline[]): Inline[] {
+  const merged: Inline[] = [];
+  for (const n of nodes) {
+    const prev = merged[merged.length - 1];
+    if (n.type === "text" && prev?.type === "text") prev.value += n.value;
+    else merged.push(n);
+  }
+  return merged;
+}
+
+export function parseMarkdown(source: string): Block[] {
+  const lines = source.replace(/\r\n?/g, "\n").split("\n");
+  const blocks: Block[] = [];
+  let paragraph: string[] = [];
+  let list: { ordered: boolean; items: string[] } | null = null;
+
+  const flushParagraph = () => {
+    if (paragraph.length > 0) {
+      blocks.push({ type: "paragraph", lines: paragraph.map(parseInline) });
+      paragraph = [];
+    }
+  };
+  const flushList = () => {
+    if (list) {
+      blocks.push({ type: "list", ordered: list.ordered, items: list.items.map(parseInline) });
+      list = null;
+    }
+  };
+
+  for (const raw of lines) {
+    const line = raw.trimEnd();
+    if (line.trim() === "") {
+      flushParagraph();
+      flushList();
+      continue;
+    }
+    const heading = /^(#{1,3})\s+(.+)$/.exec(line);
+    if (heading) {
+      flushParagraph();
+      flushList();
+      blocks.push({ type: "heading", level: heading[1].length as 1 | 2 | 3, content: parseInline(heading[2]) });
+      continue;
+    }
+    if (/^(-{3,}|\*{3,})$/.test(line.trim())) {
+      flushParagraph();
+      flushList();
+      blocks.push({ type: "rule" });
+      continue;
+    }
+    const bullet = /^\s*[-*]\s+(.+)$/.exec(line);
+    const numbered = /^\s*\d+[.)]\s+(.+)$/.exec(line);
+    if (bullet || numbered) {
+      flushParagraph();
+      const ordered = !bullet;
+      if (list && list.ordered !== ordered) flushList();
+      if (!list) list = { ordered, items: [] };
+      list.items.push((bullet ?? numbered)![1]);
+      continue;
+    }
+    flushList();
+    paragraph.push(line);
+  }
+  flushParagraph();
+  flushList();
+  return blocks;
+}
diff -ruN a/supabase/migrations/0016_public_page_results.sql b/supabase/migrations/0016_public_page_results.sql
--- a/supabase/migrations/0016_public_page_results.sql	1970-01-01 00:00:00.000000000 +0000
+++ b/supabase/migrations/0016_public_page_results.sql	2026-11-20 00:26:01.000000000 +0000
@@ -0,0 +1,138 @@
+-- =============================================================================
+-- Q-Score Pro : 0016
+-- 大会ホームページ: 受付期間の列の統合 / エントリー状況・大会結果の公開
+--
+-- 1. 0015 で作った entry_opens_at / entry_closes_at は、0002 から存在する
+--    entry_starts_at / entry_ends_at と同じ概念だった(CMS画面と公開ページが既に使用)。
+--    正を entry_starts_at / entry_ends_at に統一し、重複列を廃止する。
+--    0015 の列に値があれば、それを引き継ぐ(0015 以降に実際に効いていた値のため)。
+--    ※ これまで「表示だけ」だった受付期間が、RLS で強制されるようになる。
+--      影響を受ける大会(受付中なのに期間外)は、下の NOTICE に大会名が出る。
+-- 2. エントリー状況: tournaments.show_entry_count が true の大会だけ、件数を公開する。
+-- 3. 大会結果: rounds.results_public が true のラウンドを、大会が PUBLISHED のときだけ公開する。
+--    公開は SECURITY DEFINER 関数で、返す列を固定する(表示名・所属・順位・得点・通過のみ。
+--    メールアドレス等は構造的に返せない)。
+-- =============================================================================
+
+-- ---------------------------------------------------------------------------
+-- 1. 受付期間の列を統合
+-- ---------------------------------------------------------------------------
+update public.tournaments
+set entry_starts_at = coalesce(entry_opens_at, entry_starts_at),
+    entry_ends_at = coalesce(entry_closes_at, entry_ends_at)
+where entry_opens_at is not null or entry_closes_at is not null;
+
+drop policy "entries_insert_public_when_open" on public.entries;
+alter table public.tournaments drop constraint tournaments_entry_window_order;
+alter table public.tournaments
+  drop column entry_opens_at,
+  drop column entry_closes_at;
+
+-- NOT VALID: 既存行は検査しない(従来は検証なしで保存できていたため)。以後の更新から強制。
+alter table public.tournaments
+  add constraint tournaments_entry_window_order
+  check (entry_starts_at is null or entry_ends_at is null or entry_starts_at < entry_ends_at)
+  not valid;
+
+comment on column public.tournaments.entry_starts_at is
+  'エントリー受付開始(null=制限なし)。REGISTRATION_OPEN の間、RLS(entries の INSERT)で強制される。';
+comment on column public.tournaments.entry_ends_at is
+  'エントリー受付締切(null=制限なし)。この時刻以降は受け付けない。';
+
+create policy "entries_insert_public_when_open"
+  on public.entries for insert
+  with check (
+    exists (
+      select 1 from public.tournaments t
+      where t.id = tournament_id
+        and t.status = 'REGISTRATION_OPEN'
+        and (t.entry_starts_at is null or t.entry_starts_at <= now())
+        and (t.entry_ends_at is null or now() < t.entry_ends_at)
+    )
+  );
+
+-- 期間が強制されるようになったことで、受付できなくなる大会を知らせる。
+do $$
+declare
+  r record;
+begin
+  for r in
+    select slug, entry_starts_at, entry_ends_at
+    from public.tournaments
+    where status = 'REGISTRATION_OPEN'
+      and ((entry_starts_at is not null and entry_starts_at > now())
+        or (entry_ends_at is not null and entry_ends_at <= now()))
+  loop
+    raise notice 'NOTE: tournament "%" is REGISTRATION_OPEN but outside its entry window (% - %); public entry is now refused until the window is changed.',
+      r.slug, r.entry_starts_at, r.entry_ends_at;
+  end loop;
+end;
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 2. エントリー状況(件数のみ)
+-- ---------------------------------------------------------------------------
+alter table public.tournaments
+  add column show_entry_count boolean not null default false;
+
+comment on column public.tournaments.show_entry_count is
+  'true なら、公開ページにエントリー件数を表示する。';
+
+create function public.public_entry_count(p_slug text)
+returns integer
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select case
+    when t.show_entry_count then
+      (select count(*)::integer from public.entries e
+       where e.tournament_id = t.id and e.status = 'SUBMITTED')
+  end
+  from public.tournaments t
+  where t.slug = p_slug
+    and t.status in ('REGISTRATION_OPEN', 'REGISTRATION_CLOSED', 'RUNNING', 'FINISHED', 'PUBLISHED');
+$$;
+
+-- ---------------------------------------------------------------------------
+-- 3. 大会結果の公開
+-- ---------------------------------------------------------------------------
+alter table public.rounds
+  add column results_public boolean not null default false;
+
+comment on column public.rounds.results_public is
+  'true のラウンドの順位表を、大会が PUBLISHED のときだけ公開ページに出す。';
+
+create function public.public_tournament_results(p_slug text)
+returns table (
+  round_id uuid,
+  round_name text,
+  round_sort integer,
+  rank integer,
+  display_name text,
+  affiliation text,
+  score numeric,
+  passed boolean
+)
+language sql
+stable
+security definer
+set search_path = public
+as $$
+  select r.id, r.name, r.sort_order, rp.rank, p.display_name, p.affiliation, rp.score, rp.passed
+  from public.tournaments t
+  join public.rounds r on r.tournament_id = t.id and r.results_public
+  join public.round_participants rp on rp.round_id = r.id
+  join public.participants p on p.id = rp.participant_id
+  where t.slug = p_slug
+    and t.status = 'PUBLISHED'
+    and rp.rank is not null
+    and p.status = 'ACTIVE'
+  order by r.sort_order, rp.rank, p.display_name;
+$$;
+
+revoke all on function public.public_entry_count(text) from public;
+revoke all on function public.public_tournament_results(text) from public;
+grant execute on function public.public_entry_count(text) to anon, authenticated;
+grant execute on function public.public_tournament_results(text) to anon, authenticated;
diff -ruN a/tests/unit/markdown.test.ts b/tests/unit/markdown.test.ts
--- a/tests/unit/markdown.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/tests/unit/markdown.test.ts	2026-11-20 00:26:01.000000000 +0000
@@ -0,0 +1,70 @@
+import { describe, expect, it } from "vitest";
+import { isSafeHref, parseInline, parseMarkdown } from "@/lib/markdown";
+
+describe("parseInline", () => {
+  it("太字・コード・リンクを取り出す", () => {
+    expect(parseInline("a **b** `c` [d](https://example.com/x) e")).toEqual([
+      { type: "text", value: "a " },
+      { type: "bold", value: "b" },
+      { type: "text", value: " " },
+      { type: "code", value: "c" },
+      { type: "text", value: " " },
+      { type: "link", href: "https://example.com/x", value: "d" },
+      { type: "text", value: " e" },
+    ]);
+  });
+
+  it("javascript: / data: のリンクはリンクにしない(書かれた文字のまま残す)", () => {
+    for (const bad of ["javascript:alert(1)", "data:text/html;base64,AAAA", "vbscript:x", "//evil.example"]) {
+      const out = parseInline(`[click](${bad})`);
+      expect(out).toEqual([{ type: "text", value: `[click](${bad})` }]);
+    }
+  });
+
+  it("http / https / mailto は許可する", () => {
+    expect(isSafeHref("http://a.example")).toBe(true);
+    expect(isSafeHref("https://a.example/p?q=1#h")).toBe(true);
+    expect(isSafeHref("mailto:staff@example.com")).toBe(true);
+    expect(isSafeHref("JAVASCRIPT:alert(1)")).toBe(false);
+    expect(isSafeHref("https://a b")).toBe(false);
+  });
+
+  it("HTML タグは解釈されず、ただの文字になる", () => {
+    expect(parseInline('<script>alert(1)</script><img src=x onerror=alert(1)>')).toEqual([
+      { type: "text", value: '<script>alert(1)</script><img src=x onerror=alert(1)>' },
+    ]);
+  });
+});
+
+describe("parseMarkdown", () => {
+  it("見出し・段落・箇条書き・番号リスト・区切り線", () => {
+    const blocks = parseMarkdown(["# 大会ルール", "", "- 1問正解で10点", "- 誤答は-5点", "", "1. 準備", "2) 開始", "", "---", "おわり"].join("\n"));
+    expect(blocks.map((b) => b.type)).toEqual(["heading", "list", "list", "rule", "paragraph"]);
+    expect(blocks[1]).toMatchObject({ type: "list", ordered: false });
+    expect((blocks[1] as { items: unknown[] }).items).toHaveLength(2);
+    expect(blocks[2]).toMatchObject({ type: "list", ordered: true });
+  });
+
+  it("連続する行は同じ段落で、行ごとに分かれる(<br> になる)", () => {
+    const [p] = parseMarkdown("1行目\n2行目");
+    expect(p).toMatchObject({ type: "paragraph" });
+    expect((p as { lines: unknown[] }).lines).toHaveLength(2);
+  });
+
+  it("CRLF でも同じ結果になる", () => {
+    expect(parseMarkdown("# a\r\n\r\n- b\r\n- c")).toEqual(parseMarkdown("# a\n\n- b\n- c"));
+  });
+
+  it("空文字・空白だけなら何も出さない", () => {
+    expect(parseMarkdown("")).toEqual([]);
+    expect(parseMarkdown("  \n \n")).toEqual([]);
+  });
+
+  it("4段階以上の # は見出しにしない(段落として残す)", () => {
+    expect(parseMarkdown("#### x")[0].type).toBe("paragraph");
+  });
+
+  it("リストの種類が変わると別のリストになる", () => {
+    expect(parseMarkdown("- a\n1. b").map((b) => b.type)).toEqual(["list", "list"]);
+  });
+});
